# OPTIONAL fallback. setup_local.ps1 stores these as Windows user environment variables instead
# (real env vars win over this file). If you do use a .env, it is git-ignored.
SIRMAN_USER=
SIRMAN_PASSWORD=
GOOGLE_SHEET_ID=
# path to the service account key JSON (git-ignored)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# optional: sheet tab name (default = first tab), EUR->THB rate, DRY_RUN=1 to not write
#GOOGLE_SHEET_TAB=
EUR_THB=38
