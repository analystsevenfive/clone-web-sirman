# Copy to .env (setup_local.ps1 does this for you). .env is git-ignored.
SIRMAN_USER=
SIRMAN_PASSWORD=
GOOGLE_SHEET_ID=
# path to the service account key JSON (git-ignored)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
# optional: sheet tab name (default = first tab), EUR->THB rate, DRY_RUN=1 to not write
#GOOGLE_SHEET_TAB=
EUR_THB=38
